<UserControl x:Class="WinPlus.RamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <DockPanel>
        <!-- Total memory -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Row}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE964;"/>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'الرام المستخدمة'}" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Height="8" Margin="34,12,0,2">
                    <Border CornerRadius="4" Background="#3A3D44"/>
                    <Border x:Name="TotalBar" CornerRadius="4" Background="{StaticResource Accent}"
                            HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                   Text="{local:Tr 'أكثر البرامج استهلاكًا للرام، وتتحدث كل ثانيتين. البرنامج اللي له أكثر من نافذة أو عملية ينحسب مرة وحدة. العلامة البرتقالية = من النظام، والحمرا = أساسي لويندوز لا تقفله.'}" TextWrapping="Wrap"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RamList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource RowBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="6" Padding="14,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center" Background="Transparent"
                                                   Foreground="{Binding WarnColor}" ToolTip="{Binding WarnTip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Height="6" Margin="12,0" VerticalAlignment="Center">
                                    <Border CornerRadius="3" Background="#3A3D44"/>
                                    <Border CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left"
                                            Width="{Binding BarWidth}"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Fg}"
                                           VerticalAlignment="Center" TextAlignment="Left" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right"/>
                                <Button Grid.Column="3" Style="{StaticResource FlatButton}" Content="{local:Tr 'إنهاء'}" Margin="12,0,0,0"
                                        Padding="12,4" Tag="{Binding}" Click="OnEnd"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

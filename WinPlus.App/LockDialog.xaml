<Window x:Class="WinPlus.LockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus"
        Title="Wibn" Icon="app.ico" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FlowDirection="{x:Static local:TrExtension.Flow}" FontFamily="Segoe UI" ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="22" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="FileText" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{local:Tr 'كلمة السر'}" Margin="0,18,0,6"/>
        <Border Height="34" CornerRadius="6" Background="#1E1F22" BorderBrush="#3F4147" BorderThickness="1">
            <PasswordBox x:Name="Pass1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                         CaretBrush="{StaticResource Fg}" VerticalContentAlignment="Center" Padding="8,0"
                         FlowDirection="LeftToRight" KeyDown="OnKey"/>
        </Border>

        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="{local:Tr 'أعد كتابة كلمة السر'}" Margin="0,12,0,6"/>
            <Border Height="34" CornerRadius="6" Background="#1E1F22" BorderBrush="#3F4147" BorderThickness="1">
                <PasswordBox x:Name="Pass2" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                             CaretBrush="{StaticResource Fg}" VerticalContentAlignment="Center" Padding="8,0"
                             FlowDirection="LeftToRight" KeyDown="OnKey"/>
            </Border>
            <TextBlock Foreground="#FFD27A" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="{local:Tr 'لو نسيت كلمة السر ما فيه أي طريقة ترجّع الملف، لا منّي ولا من أي أحد.'}"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" Maximum="1" Visibility="Collapsed"
                     Foreground="{StaticResource Accent}" Background="#3A3D44" BorderThickness="0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
            <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Click="OnOk" MinWidth="90"/>
            <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="{local:Tr 'إلغاء'}" Click="OnCancel"
                    Margin="8,0,0,0" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>

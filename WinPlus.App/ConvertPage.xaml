<UserControl x:Class="WinPlus.ConvertPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <StackPanel x:Name="Root">
        <!-- How to use it -->
        <Border Background="{StaticResource RowBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="20" Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32" Background="#1F0A84FF" Margin="0,0,16,0">
                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                               Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr 'اسحب ملف واضغط Space'}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{local:Tr 'وأنت تسحب أي ملف من المستكشف أو سطح المكتب، اضغط Space وتطلع قائمة دائرية تحت الماوس. أفلت الملف على الصيغة اللي تبيها والملف نفسه يتحول. Space مرة ثانية أو Esc يسكّرها.'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Columns="2" Margin="-3,0">
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE765;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'القائمة مع المسافة'}"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="{local:Tr 'تشتغل بس وأنت تسحب ملف، وما تأثر على الكتابة'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <Button x:Name="FfmpegButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{local:Tr 'تحميل'}"
                            VerticalAlignment="Center" Click="OnDownloadFfmpeg"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE896;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="FFmpeg"/>
                        <TextBlock x:Name="FfmpegText" Style="{StaticResource RowDesc}"/>
                        <ProgressBar x:Name="FfmpegProgress" Height="4" Maximum="1" Margin="0,6,0,0" Visibility="Collapsed"
                                     Foreground="{StaticResource Accent}" Background="#3A3D44" BorderThickness="0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Row}" Margin="0,0,0,6">
            <DockPanel>
                <CheckBox x:Name="KeepBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                          Checked="OnKeepChanged" Unchecked="OnKeepChanged"/>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE777;"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'تقدر ترجع للأصل'}"/>
                    <TextBlock Style="{StaticResource RowDesc}"
                               Text="{local:Tr 'الأصل ينحفظ مخفي 30 يوم: لو حولت مقطع لصوت تقدر ترجعه مقطع، والرجوع لصيغته الأصلية فوري. لو طفيته الأصل يروح لسلة المهملات'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Style="{StaticResource Section}" Text="{local:Tr 'الصيغ'}" Margin="2,24,0,8" FontSize="18"/>
        <UniformGrid Columns="3" Margin="-3,0">
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'الصور'}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource RowDesc}" FlowDirection="LeftToRight" HorizontalAlignment="Right"
                               Text="PNG · JPG · WEBP · AVIF · PDF · ICO · BMP · TIFF · GIF"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'المقاطع'}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource RowDesc}" FlowDirection="LeftToRight" HorizontalAlignment="Right"
                               Text="MP4 · WEBM · MKV · MOV · AVI · GIF · MP3 · WAV"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'الصوت'}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource RowDesc}" FlowDirection="LeftToRight" HorizontalAlignment="Right"
                               Text="MP3 · WAV · FLAC · M4A · OGG · OPUS"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>

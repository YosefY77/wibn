<UserControl x:Class="WinPlus.FileLockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <StackPanel>
        <!-- Drop zone -->
        <Border x:Name="DropZone" AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave"
                Background="{StaticResource RowBg}" BorderBrush="#4A4D55" BorderThickness="1.5" CornerRadius="8"
                Padding="20,28" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="{local:Tr 'اسحب ملف أو مجلد هنا'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="{local:Tr 'الملف أو المجلد العادي ينقفل، والمقفول (.wplock) ينفتح'}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'قفل ملف…'}" Click="OnPickLock"/>
                    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'قفل مجلد…'}" Click="OnPickFolder" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource FlatButton}" Content="{local:Tr 'فتح المقفول…'}" Click="OnPickUnlock" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,12"
                   Visibility="Collapsed"/>

        <UniformGrid Columns="2" Margin="-3,0">
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <CheckBox x:Name="RelockBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Checked="OnRelockChanged" Unchecked="OnRelockChanged"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE72E;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'يرجع يتقفل لما تسكّره'}"/>
                        <TextBlock Style="{StaticResource RowDesc}"
                                   Text="{local:Tr 'تفتحه بكلمة السر، ولما تسكّر البرنامج اللي فاتحه يتقفل لحاله بنفس الكلمة. أيقونة درع جنب الساعة تقفله على طول'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <CheckBox x:Name="ShellBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Checked="OnShellChanged" Unchecked="OnShellChanged"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8A5;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'في الكليك يمين'}"/>
                        <TextBlock Style="{StaticResource RowDesc}"
                                   Text="{local:Tr '&quot;قفل بكلمة سر&quot; على أي ملف أو مجلد (في ويندوز 11 تحت: عرض المزيد من الخيارات)، والمقفول ينفتح بدبل كليك'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7BA;" Foreground="#FFD27A"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'انتبه'}"/>
                        <TextBlock Style="{StaticResource RowDesc}"
                                   Text="{local:Tr 'القفل تشفير حقيقي (AES-256). لو نسيت كلمة السر الملف يضيع نهائيًا. والأصلي ينمسح بعد القفل.'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>

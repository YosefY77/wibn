<UserControl x:Class="WinPlus.CursorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <StackPanel>
        <UniformGrid Columns="2" Margin="-3,0">
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8B0;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'مؤشر مخصص'}"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="{local:Tr 'لما تطفيه يرجع مؤشر ويندوز اللي كان عندك'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <CheckBox x:Name="HandBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Checked="OnHandChanged" Unchecked="OnHandChanged"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE71B;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'نفس المؤشر على الروابط'}"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="{local:Tr 'بدل اليد اللي تطلع على الروابط والأزرار'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- Size: Windows' own pointer size, works with or without the custom pointer -->
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Width="56" VerticalAlignment="Center"
                           TextAlignment="Center" FlowDirection="LeftToRight"/>
                <Slider x:Name="SizeSlider" DockPanel.Dock="Right" Width="260" Minimum="32" Maximum="256"
                        TickFrequency="16" IsSnapToTickEnabled="True" FlowDirection="LeftToRight"
                        VerticalAlignment="Center" ValueChanged="OnSizeChanged"
                        PreviewMouseLeftButtonUp="OnSizeCommit" LostMouseCapture="OnSizeCommit" KeyUp="OnSizeCommit"/>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE740;"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'الحجم'}"/>
                    <TextBlock Style="{StaticResource RowDesc}" Text="{local:Tr 'حجم ويندوز العادي 32 بكسل، ويتغير لكل المؤشرات'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Style="{StaticResource Section}" Text="{local:Tr 'الشكل'}" Margin="2,24,0,8" FontSize="18"/>

        <Border Style="{StaticResource Row}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Width="340">
                    <!-- Color or picture -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="ModeColor" Style="{StaticResource NavButton}" Content="{local:Tr 'لون'}" GroupName="CursorMode"
                                     Checked="OnModeChanged" Padding="18,6"/>
                        <RadioButton x:Name="ModeImage" Style="{StaticResource NavButton}" Content="{local:Tr 'صورة'}" GroupName="CursorMode"
                                     Checked="OnModeChanged" Padding="18,6" Margin="6,0,0,0"/>
                    </StackPanel>

                    <local:ColorPicker x:Name="Picker"/>

                    <StackPanel x:Name="ImagePanel" Visibility="Collapsed">
                        <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'اختر صورة…'}" HorizontalAlignment="Left"
                                Click="OnPickImage"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{local:Tr 'PNG أو JPG أو GIF أو ICO، أو ملف مؤشر جاهز (.cur / .ani). الأفضل PNG بخلفية شفافة.'}"/>
                        <TextBlock Text="{local:Tr 'وين يضغط المؤشر؟'}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="HotspotBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnHotspotChanged">
                            <ComboBoxItem Content="{local:Tr 'الزاوية اللي فوق يسار'}"/>
                            <ComboBoxItem Content="{local:Tr 'وسط الصورة'}"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <DockPanel Grid.Column="1" Margin="20,0,0,0">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Content="{local:Tr 'رجّع مؤشر ويندوز'}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset"/>
                    <!-- Preview on dark and light, like it will look on screen -->
                    <UniformGrid Columns="2" MinHeight="160">
                        <Border Background="#202124" CornerRadius="6,0,0,6">
                            <Image x:Name="PreviewDark" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <Border Background="#F3F3F3" CornerRadius="0,6,6,0">
                            <Image x:Name="PreviewLight" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </UniformGrid>
                </DockPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

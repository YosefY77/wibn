<UserControl x:Class="WinPlus.TempCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="CleanButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}"
                    Content="{local:Tr 'تنظيف المحدد'}" Click="OnClean" Margin="0"/>
            <Button x:Name="RefreshButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}"
                    Content="{local:Tr 'إعادة الحساب'}" Click="OnRefresh" Margin="8,0,0,0"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="12,0,0,0"/>
        </DockPanel>

        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="6">
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource FileRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                      Margin="0,0,10,0" Click="OnCheckClicked"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0" FlowDirection="LeftToRight"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>

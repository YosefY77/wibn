<UserControl x:Class="WinPlus.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <StackPanel>
        <UniformGrid Columns="2" Margin="-3,0">
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <CheckBox x:Name="AutoBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Checked="OnAutoChanged" Unchecked="OnAutoChanged"/>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE895;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'ترتيب تلقائي'}"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="{local:Tr 'أي ملف ينزل يروح لمجلده أول ما يخلص تحميله'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Margin="3,0,3,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Style="{StaticResource FlatButton}" Content="{local:Tr 'تراجع'}" Click="OnUndo"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'رتّب الحين'}" Click="OnSortNow"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8CB;"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'ترتيب الموجود'}"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="{local:Tr 'ينقل كل الملفات اللي في التحميلات الحين'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Row}" Margin="0,0,0,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{local:Tr 'اختر مجلد…'}"
                        VerticalAlignment="Center" Click="OnSortOther"/>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8B7;"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'ترتيب أي مجلد ثاني'}"/>
                    <TextBlock Style="{StaticResource RowDesc}"
                               Text="{local:Tr 'مثل سطح المكتب أو أي مجلد مليان ملفات. أو كليك يمين على المجلد ← ترتيب الملفات حسب النوع (في ويندوز 11 تحت: عرض المزيد من الخيارات)'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,4,0,4"
                   Visibility="Collapsed"/>

        <DockPanel Margin="2,20,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{local:Tr 'فتح التحميلات'}" Click="OnOpenFolder"/>
            <TextBlock Style="{StaticResource Section}" Text="{local:Tr 'المجلدات'}" FontSize="18" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="FolderText" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,10"
                   FlowDirection="LeftToRight" HorizontalAlignment="Right"/>

        <!-- One row per category, built in code -->
        <UniformGrid x:Name="CategoryGrid" Columns="2" Margin="-3,0"/>

        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"
                   Text="{local:Tr 'الملفات اللي نوعها مو في القائمة تبقى مكانها، والمجلدات ما تنلمس. لو فيه ملف بنفس الاسم ينضاف له رقم بدل ما يتبدّل.'}"/>
    </StackPanel>
</UserControl>

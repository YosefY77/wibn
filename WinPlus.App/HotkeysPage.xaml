<UserControl x:Class="WinPlus.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <DockPanel>
        <!-- Add a shortcut -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Card}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{local:Tr 'اختصار جديد'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{local:Tr 'الأزرار:'}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <Border Grid.Column="1" Height="34" CornerRadius="6" Margin="0,0,0,8"
                            Background="#1E1F22" BorderBrush="#3F4147" BorderThickness="1">
                        <TextBox x:Name="KeyBox" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                 Foreground="{StaticResource Fg}" CaretBrush="Transparent" FlowDirection="LeftToRight"
                                 VerticalContentAlignment="Center" Padding="8,0" Cursor="Hand"
                                 PreviewKeyDown="OnKeyCapture" GotKeyboardFocus="OnKeyBoxFocus"
                                 LostKeyboardFocus="OnKeyBoxBlur"/>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{local:Tr 'الإجراء:'}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <ComboBox x:Name="ActionBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,0,0,8"
                              VerticalContentAlignment="Center" SelectionChanged="OnActionChanged"/>

                    <TextBlock x:Name="TargetLabel" Grid.Row="2" Text="{local:Tr 'الهدف:'}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DockPanel x:Name="TargetRow" Grid.Row="2" Grid.Column="1">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{local:Tr 'تصفح…'}"
                                Click="OnBrowse" Margin="8,0,0,0"/>
                        <Border Height="34" CornerRadius="6" Background="#1E1F22" BorderBrush="#3F4147" BorderThickness="1">
                            <TextBox x:Name="TargetBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                                     FlowDirection="LeftToRight" VerticalContentAlignment="Center" Padding="8,0"
                                     ToolTip="{local:Tr 'مسار برنامج أو ملف أو مجلد، أو رابط موقع'}"/>
                        </Border>
                    </DockPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'إضافة'}" Click="OnAdd"/>
                    <TextBlock x:Name="AddStatus" VerticalAlignment="Center" Foreground="#FF8A80" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Existing shortcuts -->
        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="6">
            <Grid>
                <ListBox x:Name="HotkeyList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FileRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="5" Background="#3A3C42" Padding="8,3" VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActionText}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="{local:Tr 'حذف'}" Margin="0"
                                        Padding="12,5" Click="OnRemove" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="{local:Tr 'ما فيه اختصارات للحين'}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

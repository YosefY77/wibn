<UserControl x:Class="WinPlus.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ProtectedFade" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Card}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="ChooseButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}"
                            Content="{local:Tr 'اختيار مجلد…'}" Click="OnChooseFolder"/>
                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{local:Tr 'أصغر حجم:'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MinSizeBox" Width="100" Margin="0,0,8,0" SelectedIndex="1">
                        <ComboBoxItem Content="100 KB" Tag="102400"/>
                        <ComboBoxItem Content="1 MB" Tag="1048576"/>
                        <ComboBoxItem Content="10 MB" Tag="10485760"/>
                        <ComboBoxItem Content="100 MB" Tag="104857600"/>
                    </ComboBox>
                    <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Content="{local:Tr 'فحص'}" Click="OnScan"
                            IsEnabled="False"/>
                    <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="{local:Tr 'إيقاف'}" Click="OnCancel"
                            Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="ScanStatus" Foreground="{StaticResource Muted}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}"
                    Content="{local:Tr 'حذف المحدد (لسلة المهملات)'}" Click="OnDelete" IsEnabled="False" Margin="0"/>
            <Button x:Name="AutoSelectButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}"
                    Content="{local:Tr 'حدد النسخ الزايدة'}" Click="OnAutoSelect" IsEnabled="False" Margin="8,0,0,0"
                    ToolTip="{local:Tr 'يخلي أقدم نسخة من كل ملف ويحدد الباقي'}"/>
            <TextBlock x:Name="SelectionText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </DockPanel>

        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="6">
            <Grid>
                <ListBox x:Name="DupList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FileRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="OnOpenLocation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Group header -->
                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="#7FA8FF"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>
                                <!-- File row -->
                                <Grid Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource ProtectedFade}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Click="OnCheckClicked" IsEnabled="{Binding CanDelete}"
                                              Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Windows / system file: locked, can't be selected -->
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="1,0,11,0"
                                               ToolTip="{local:Tr 'ملف نظام أو ويندوز، ما ينحذف عشان ما يخرب الجهاز.'}"
                                               Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Grid.Column="1" ToolTip="{Binding Tip}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="{StaticResource Muted}"
                                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="{local:Tr 'اختر مجلد (أو قرص كامل) واضغط فحص'}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

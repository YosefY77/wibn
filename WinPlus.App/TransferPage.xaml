<UserControl x:Class="WinPlus.TransferPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <StackPanel>
        <!-- Helper not downloaded yet -->
        <Border x:Name="SetupRow" Style="{StaticResource Row}" Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="SetupButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{local:Tr 'تجهيز'}"
                        VerticalAlignment="Center" Click="OnSetup"/>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE896;"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'يحتاج تجهيز مرة وحدة'}"/>
                    <TextBlock x:Name="SetupText" Style="{StaticResource RowDesc}"
                               Text="{local:Tr 'ينزّل أداة الإرسال المباشر (sendme، مفتوحة المصدر، كم ميقا). خويك يحتاجها بعد عنده في Wibn.'}"/>
                    <ProgressBar x:Name="SetupProgress" Height="4" Maximum="1" Margin="0,6,0,0" Visibility="Collapsed"
                                 Foreground="{StaticResource Accent}" Background="#3A3D44" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Columns="2" Margin="-3,0">
            <!-- Send -->
            <Border Style="{StaticResource Row}" Margin="3,0,3,6" Padding="20">
                <StackPanel>
                    <TextBlock Text="{local:Tr 'إرسال'}" FontSize="17" FontWeight="SemiBold"/>
                    <Border x:Name="DropZone" AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave"
                            Background="#1E1F22" BorderBrush="#4A4D55" BorderThickness="1.5" CornerRadius="8"
                            Padding="12,22" Margin="0,12,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{local:Tr 'اسحب ملف أو مجلد هنا'}" HorizontalAlignment="Center" Margin="0,8,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource FlatButton}" Content="{local:Tr 'ملف…'}" Click="OnPickFile"/>
                                <Button Style="{StaticResource FlatButton}" Content="{local:Tr 'مجلد…'}" Click="OnPickFolder" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SendPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="SendName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{local:Tr 'أرسل هالكود لخويك:'}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{local:Tr 'نسخ'}" Click="OnCopy" Margin="8,0,0,0"/>
                            <Border Height="34" CornerRadius="6" Background="#1E1F22" BorderBrush="#3F4147" BorderThickness="1">
                                <TextBox x:Name="CodeBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Fg}" VerticalContentAlignment="Center" Padding="8,0"
                                         FlowDirection="LeftToRight" FontFamily="Consolas"/>
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="SendStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Style="{StaticResource FlatButton}" Content="{local:Tr 'إيقاف المشاركة'}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnStopSend"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Receive -->
            <Border Style="{StaticResource Row}" Margin="3,0,3,6" Padding="20">
                <StackPanel>
                    <TextBlock Text="{local:Tr 'استلام'}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:Tr 'الصق الكود اللي أرسله لك خويك:'}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,4"/>
                    <Border Height="34" CornerRadius="6" Background="#1E1F22" BorderBrush="#3F4147" BorderThickness="1">
                        <TextBox x:Name="ReceiveBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                                 CaretBrush="{StaticResource Fg}" VerticalContentAlignment="Center" Padding="8,0"
                                 FlowDirection="LeftToRight" FontFamily="Consolas"/>
                    </Border>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="ReceiveButton" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="{local:Tr 'استلام'}"
                                Click="OnReceive"/>
                        <Button x:Name="CancelReceiveButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{local:Tr 'إلغاء'}"
                                Click="OnCancelReceive" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="FolderText" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="10,0,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <StackPanel x:Name="ReceivePanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <ProgressBar x:Name="ReceiveProgress" Height="6" Maximum="1"
                                     Foreground="{StaticResource Accent}" Background="#3A3D44" BorderThickness="0"/>
                        <TextBlock x:Name="ReceiveStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"
                   Text="{local:Tr 'الملف ينتقل مباشرة من جهازك لجهاز خويك عبر الإنترنت ومشفّر، بدون حد للحجم، والسرعة حسب نت الطرفين. لو الراوتر منع الاتصال المباشر يمر عبر سيرفر وسيط مجاني (أبطأ). خل البرنامج شغّال لين يخلص خويك، ولو انقطع النت يكمّل من مكان ما وقف. أول مرة ممكن يسألك جدار الحماية: اسمح له.'}"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="WinPlus.DesktopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPlus">
    <StackPanel>
        <TextBlock Style="{StaticResource Section}" Text="{local:Tr 'مربع التحديد'}" Margin="2,8,0,8" FontSize="18"/>

        <UniformGrid Columns="2" Margin="-3,0">
        <Border Style="{StaticResource Row}" Margin="3,0,3,6">
            <DockPanel>
                <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                          Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7A8;"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'لون مخصص لمربع التحديد'}"/>
                    <TextBlock Style="{StaticResource RowDesc}"
                               Text="{local:Tr 'المربع اللي يطلع لما تسحب الماوس على سطح المكتب أو داخل المجلدات. لما تطفيه يرجع لونه الأصلي.'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Row}" Margin="3,0,3,6">
            <DockPanel>
                <CheckBox x:Name="BorderBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                          Checked="OnBorderChanged" Unchecked="OnBorderChanged"/>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE81E;"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'نفس اللون للحدود'}"/>
                    <TextBlock Style="{StaticResource RowDesc}"
                               Text="{local:Tr 'لون الحدود هو لون التحديد في بعض البرامج القديمة بعد، فيتغير معاه.'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        </UniformGrid>

        <!-- Picker on one side, preview and reset on the other -->
        <Border Style="{StaticResource Row}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:ColorPicker x:Name="Picker" Width="320" VerticalAlignment="Top"/>
                <DockPanel Grid.Column="1" Margin="20,0,0,0">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Content="{local:Tr 'رجّع اللون الأصلي'}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset"/>
                    <!-- Preview: same look as Windows (light fill, solid border) -->
                    <Border CornerRadius="6" Background="#202020" MinHeight="120">
                        <Border x:Name="Preview" Width="160" Height="90" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Section}" Text="{local:Tr 'مؤشر الماوس'}" Margin="2,28,0,8" FontSize="18"/>
        <local:CursorPage/>
    </StackPanel>
</UserControl>
